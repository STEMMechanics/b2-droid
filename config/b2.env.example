B2_APP_DIR=/opt/b2-droid
B2_DATA_DIR=/var/lib/b2-droid
B2_CONFIG_DIR=/opt/b2-droid/config
B2_SERIAL_PORT=/dev/ttyACM0
B2_ARDUINO_FQBN=arduino:avr:uno
B2_FLASH_ARDUINO=true
B2_AUDIO_DEVICE=plughw:1,0
B2_MIN_SPEECH_THRESHOLD=100
B2_AMBIENT_MULTIPLIER=1.30
B2_SPEECH_PREROLL_SECONDS=1.0
B2_MAX_TRANSCRIPTION_CONTINUATIONS=2
# ALSA playback device. This may be the same card as the microphone, but it is
# configured separately so a USB microphone does not redirect B2's voice.
B2_OUTPUT_DEVICE=plughw:1,0
B2_VOLUME=100
B2_STARTUP_VOLUME_FLOOR=100
B2_AUTO_VOLUME=true
B2_CAMERA=/dev/video0
B2_PIPER_MODEL=/opt/b2-droid/voices/en_GB-alba-medium.onnx
B2_WHISPER=/opt/b2-droid/whisper.cpp/build/bin/whisper-cli
B2_VISION_MODEL=/opt/b2-droid/yolo11n.onnx
B2_TIMEZONE=Australia/Brisbane
B2_LOCATION=home
B2_OBSERVATION_INTERVAL=30
B2_MAX_OBSERVATIONS=5000
B2_CHAT_API=http://127.0.0.1:8080/v1/chat/completions
# auto preserves a responsive compatible endpoint; true forces bundled llama.cpp;
# false leaves model-server installation entirely to the adult administrator.
B2_INSTALL_LLM=auto
B2_LLM_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
B2_LLM_CONTEXT_SIZE=4096
B2_MAX_CONVERSATION_MESSAGES=12
# Optional SearXNG JSON endpoint, for example https://search.example/search
# B2_WEB_SEARCH_URL=
B2_PENDING_AI_RETRY_DELAY=60
B2_ADMIN_NAMES=James
# Required to enable the adult web dashboard. Choose a long unique password.
# B2_WEB_PASSWORD=change-this-before-enabling
B2_WEB_USERNAME=admin
B2_WEB_HOST=0.0.0.0
B2_WEB_PORT=8088
B2_LOG_FILE=/var/log/b2-droid/app.log
B2_LOG_DIR=/var/log/b2-droid
B2_READY_SOUND=true
B2_EMOTION_SOUNDS=true
B2_EMOTION_SOUND_COOLDOWN=20
B2_VOLUME=65
B2_AUTO_VOLUME=true
# Seconds before B2 may greet a newly arriving person again.
B2_CURIOSITY_COOLDOWN=300
B2_CURIOSITY_ABSENCE_RESET=8
B2_MIN_TURN_PULSE=0.16
B2_TURN_SECONDS=0.16
B2_TURN_AROUND_SECONDS=1.0
B2_AI_LOOK_SECONDS=0.10
B2_TRACK_PERSON=true
B2_TRACK_WHILE_IDLE=true
B2_TRACK_DEAD_ZONE=0.12
B2_TRACK_MIN_PULSE=0.04
B2_TRACK_EFFECTIVE_DEAD_ZONE=0.18
B2_TRACK_EFFECTIVE_MIN_PULSE=0.08
B2_TRACK_MAX_PULSE=0.22
B2_TRACK_PULSE_GAIN=0.20
B2_TRACK_INTERVAL=0.25
B2_TRACK_REVERSE_DEAD_ZONE=0.30
B2_TRACK_DIRECTION_CHANGE_DELAY=1.0
B2_TRACK_INVERT=false
B2_TRACK_LOST_DELAY=0.7
B2_TRACK_SEARCH_SECONDS=6
B2_TRACK_SEARCH_PULSE=0.10
B2_FACE_IDENTITY_ABSENCE_GRACE=12
B2_EXPLORATION_IDLE_SECONDS=45
B2_EXPLORATION_INTERVAL=75
B2_EXPLORATION_PULSE=0.30
B2_VISION_INTERVAL=0.15
B2_PERSON_VISIBILITY_HOLD_SECONDS=2.5
B2_MOTOR_SPEED=180
B2_MOTOR_STARTUP_FLOOR=220
B2_MOTOR_SPEED_MIN=110
B2_MOTOR_SPEED_MAX=240
B2_VISUAL_STALLS_REQUIRED=2
B2_MOTOR_STALL_COOLDOWN=30
B2_VISUAL_STALLS_REQUIRED=2
B2_MOTION_VERIFY_SETTLE=0.35
B2_MOTION_DIFFERENCE_THRESHOLD=4.0
B2_MOTION_TEXTURE_THRESHOLD=8.0
B2_IDLE_SCAN=true
B2_IDLE_SCAN_DELAY=10
B2_IDLE_SCAN_INTERVAL=1.2
B2_IDLE_SWEEP_PULSE=0.35
B2_IDLE_SCAN_STEPS=4
B2_VOICE_SEARCH_SECONDS=25
B2_VOICE_SEARCH_INTERVAL=0.65
B2_VOICE_SEARCH_STEPS=10
B2_PERSON_FOCUS_HOLD_SECONDS=120
# Accept speech without the wake phrase when a visible person is this much
# louder than the normal speech threshold.
B2_CLOSE_SPEECH_MULTIPLIER=1.8
B2_RETRY_NOISE_TRANSCRIPTIONS=true
B2_TRANSPARENT_FACE_LEARNING=true
B2_FACE_ENROLMENT_SAMPLES=12
B2_FACE_ENROLMENT_TIMEOUT=45
B2_FACE_MATCH_TOLERANCE=0.62
B2_FACE_RECOGNITION_SCALE=0.65
B2_FACE_IDENTITY_HOLD_SECONDS=120
B2_UNKNOWN_PERSON_GRACE=3
B2_SILENCE_SECONDS=2.0
# Optional Slack Socket Mode integration (keep real secrets in /etc/b2-droid.env):
# B2_SLACK_BOT_TOKEN=xoxb-...
# B2_SLACK_APP_TOKEN=xapp-...
# B2_SLACK_ALLOWED_CHANNEL=C0123456789
