[Unit]
Description=B2 removable-media update watcher
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=-/etc/b2-droid.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/b2-bootloader
Environment=B2_APP_DIR=/opt/b2-droid
Environment=B2_DATA_DIR=/var/lib/b2-droid
WorkingDirectory=/opt/b2-bootloader
ExecStart=/usr/bin/python3 -m b2.updater_daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
