[Unit]
Description=B2 local language model
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=droid
Group=droid
EnvironmentFile=-/etc/b2-droid.env
WorkingDirectory=/opt/b2-droid
ExecStart=/usr/bin/bash /opt/b2-droid/scripts/start-llm.sh
Restart=always
RestartSec=5
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
